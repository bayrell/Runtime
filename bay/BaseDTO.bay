namespace Runtime;

use Runtime.BaseObject;
use Runtime.Serializer.BaseType;
use Runtime.Serializer.ObjectType;
use Runtime.SerializeInterface;


class BaseDTO extends BaseObject implements SerializeInterface
{
	/**
	 * Create object
	 */
	void constructor(Map params = null)
	{
		parent();
		this._assign_values(params);
	}
	
	
	/**
	 * Returns field by name
	 */
	var get(string field_name) => rtl::attr(this, field_name);
	
	
	/**
	 * Set field value
	 */
	void set(string field_name, var value)
	{
		rtl::setAttr(this, field_name, value);
	}
	
	
	/**
	 * Assign data
	 */
	static BaseDTO create(Map data, Vector errors = [])
	{
		BaseDTO item = rtl::newInstance(static::getClassName());
		rtl::assign(item, data, errors);
		return item;
	}
	
	
	/**
	 * Set value
	 */
	void setValue(string field_name, var value)
	{
		value = static::filter(field_name, value);
		this.set(field_name, value);
	}
	
	
	/**
	 * Set field
	 */
	static void filter(string field_name, var item)
	{
		ObjectType rules = new ObjectType;
		static::serialize(rules);
		BaseType field_rule = rules.items.get(field_name)
			.get(0);
		if (!field_rule) return;
		
		Vector errors = [];
		return field_rule.filter(item, errors);
	}
	
	
	/**
	 * Copy object
	 */
	BaseDTO copy() => rtl::copy(this);
	
	
	/**
	 * Returns object data
	 */
	Map all() => rtl::serialize(this);
	
	
	/**
	 * Intersect data
	 */
	Map intersect(Vector items) => this.all().intersect(items);
}
